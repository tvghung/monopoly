{
  "name": "@monopoly/client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/validateGameplayMusicAssets.mjs --build-output",
    "prepare:music-assets": "node scripts/generateGameplayMusicSegments.mjs",
    "validate:music-assets": "node scripts/validateGameplayMusicAssets.mjs",
    "validate:music-release": "node scripts/validateMusicRelease.mjs",
    "test:music-pipeline": "node scripts/generateGameplayMusicSegments.check.mjs",
    "test:music-validator": "node scripts/validateGameplayMusicAssets.check.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/validateGameplayMusicAssets.mjs && vitest run --environment jsdom --pool=vmThreads --maxWorkers=1 --no-file-parallelism",
    "test:music-transport": "vitest run src/audio/AudioEngine.test.ts src/audio/SegmentedMusicTransport.test.ts src/audio/AudioProvider.test.tsx --environment jsdom --pool=vmThreads --maxWorkers=1 --no-file-parallelism",
    "test:watch": "vitest --environment jsdom --pool=vmThreads"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@monopoly/shared": "workspace:*",
    "@react-three/fiber": "^9.6.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.37.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.3",
    "three": "^0.185.0",
    "troika-three-text": "^0.52.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "26.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
