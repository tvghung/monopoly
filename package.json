{
  "name": "monopoly-websockets",
  "version": "3.0.0",
  "description": "Real-time multiplayer Monopoly (Express + Socket.IO + React/Vite)",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:migrate": "pnpm --filter @monopoly/server db:migrate",
    "db:status": "pnpm --filter @monopoly/server db:status",
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --parallel --filter @monopoly/server --filter @monopoly/client dev",
    "dev:desktop": "pnpm --filter @monopoly/desktop dev",
    "dev:desktop:shell": "pnpm --filter @monopoly/desktop dev:shell",
    "desktop:package": "pnpm --filter @monopoly/desktop package",
    "desktop:make": "pnpm --filter @monopoly/desktop make",
    "desktop:release": "node apps/desktop/scripts/release.mjs",
    "validate:release": "node apps/desktop/scripts/validateRelease.mjs",
    "build": "pnpm --filter @monopoly/client build",
    "start": "pnpm --filter @monopoly/server start",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
